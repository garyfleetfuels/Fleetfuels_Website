---
import { siteConfig } from '../data/siteData';
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#2D3136] text-white border-t border-slate-700/60 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12">
    <!-- Top Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-700/80">
      <!-- Brand & Mission Column -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center space-x-3 group" aria-label="Fleet Fuels Homepage">
          <img
            src="/images/fleet_fuels_logo_with_tagline_transparent.png"
            alt="Fleet Fuels - Fuelling your fleet, powering your business"
            class="h-14 lg:h-16 w-auto object-contain brightness-0 invert opacity-90 transition-opacity group-hover:opacity-100"
            width="280"
            height="70"
          />
        </a>

        <div class="text-xs font-bold text-[#86ef9e] uppercase tracking-wider">
          {siteConfig.slogan}
        </div>

        <p class="text-slate-400 text-xs sm:text-sm leading-relaxed max-w-sm">
          Fleet Fuels is a specialist commercial fuel card consultancy providing direct trade terms, wholesale commercial pricing, and transparent account management with zero creeping margins across the UK.
        </p>

        <div class="space-y-2 text-xs text-slate-300 pt-2">
          <p class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-[#469B26] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Direct Advisory Line: <a href="tel:07525863838" class="text-white hover:text-[#86ef9e] font-bold">07525 863838</a></span>
          </p>
          <p class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-[#469B26] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>General Inquiries: <a href="mailto:enquiries@fleetfuels.co.uk" class="text-[#86ef9e] hover:underline">enquiries@fleetfuels.co.uk</a></span>
          </p>
        </div>
      </div>

      <!-- Navigation Link Columns -->
      {siteConfig.footerNav.map((col) => (
        <div>
          <h2 class="text-sm font-bold text-white uppercase tracking-wider mb-4">
            {col.title}
          </h2>
          <ul class="space-y-2.5 text-xs sm:text-sm text-slate-300">
            {col.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="hover:text-[#86ef9e] transition-colors"
                >
                  {item.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Departmental Contact & Customer Support Hub -->
    <div class="my-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 p-6 rounded-2xl bg-white/5 border border-slate-700/70 text-xs">
      <div class="space-y-1">
        <span class="font-bold text-[#86ef9e] uppercase tracking-wider block text-[11px]">General Inquiries</span>
        <p class="text-slate-400 text-[11px]">Primary point of contact & fleet guidance</p>
        <a href="mailto:enquiries@fleetfuels.co.uk" class="text-white hover:text-[#86ef9e] font-semibold flex items-center pt-1 transition-colors">
          <span>enquiries@fleetfuels.co.uk</span>
        </a>
      </div>

      <div class="space-y-1">
        <span class="font-bold text-[#86ef9e] uppercase tracking-wider block text-[11px]">Rate Comparisons & Sales</span>
        <p class="text-slate-400 text-[11px]">Fuel rate audits & switch your fleet tenders</p>
        <a href="mailto:sales@fleetfuels.co.uk" class="text-white hover:text-[#86ef9e] font-semibold flex items-center pt-1 transition-colors">
          <span>sales@fleetfuels.co.uk</span>
        </a>
      </div>

      <div class="space-y-1">
        <span class="font-bold text-[#86ef9e] uppercase tracking-wider block text-[11px]">Account Management & Support</span>
        <p class="text-slate-400 text-[11px]">Existing customers, lost/stolen cards & billing</p>
        <a href="mailto:support@fleetfuels.co.uk" class="text-white hover:text-[#86ef9e] font-semibold flex items-center pt-1 transition-colors">
          <span>support@fleetfuels.co.uk</span>
        </a>
      </div>

      <div class="space-y-1">
        <span class="font-bold text-[#86ef9e] uppercase tracking-wider block text-[11px]">Registered Office & Corporate</span>
        <p class="text-slate-400 text-[11px]">Head office, legal & compliance inquiries</p>
        <a href="mailto:contact@fleetfuels.co.uk" class="text-white hover:text-[#86ef9e] font-semibold flex items-center pt-1 transition-colors">
          <span>contact@fleetfuels.co.uk</span>
        </a>
      </div>
    </div>

    <!-- Trust & Compliance Badges -->
    <div class="py-6 flex flex-wrap items-center justify-between gap-4 text-xs text-slate-400 border-b border-slate-700/60">
      <div class="flex flex-wrap items-center gap-6">
        <span class="inline-flex items-center text-slate-300">
          <svg class="w-4 h-4 mr-1.5 text-[#469B26]" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          No Creeping Margins Guarantee
        </span>
        <span class="inline-flex items-center text-slate-300">
          <svg class="w-4 h-4 mr-1.5 text-[#469B26]" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          HMRC-Approved Consolidated VAT Invoicing
        </span>
        <span class="inline-flex items-center text-slate-300">
          <svg class="w-4 h-4 mr-1.5 text-[#469B26]" fill="currentColor" viewBox="0 0 20 20">
            <path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" />
            <path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H11a1 1 0 001-1v-1h3.05a2.5 2.5 0 014.9 0H21a1 1 0 001-1v-5a1 1 0 00-.293-.707l-3-3A1 1 0 0018 4H3z" />
          </svg>
          8,000+ UK Forecourts Across 5 Primary Networks
        </span>
      </div>
      <div class="text-slate-400">
        Big Fleet Prices. Small Business Service.
      </div>
    </div>

    <!-- Bottom Copyright & Corporate Address -->
    <div class="pt-6 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-400 gap-4">
      <div>
        <p>© {currentYear} {siteConfig.name}. All rights reserved. Registered in the United Kingdom.</p>
        <p class="text-[11px] text-slate-500 mt-0.5">{siteConfig.address.line1}, {siteConfig.address.city}, {siteConfig.address.postcode} • Corporate enquiries: <a href="mailto:contact@fleetfuels.co.uk" class="text-slate-400 hover:text-white underline">contact@fleetfuels.co.uk</a></p>
      </div>
      <div class="flex items-center space-x-6">
        <a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-white transition-colors">Terms of Service</a>
        <a href="/cookies" class="hover:text-white transition-colors">Cookies</a>
        <a href="/llms.txt" class="hover:text-[#86ef9e] transition-colors font-medium">llms.txt</a>
      </div>
    </div>
  </div>
</footer>
