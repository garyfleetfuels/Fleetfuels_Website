---
import { siteConfig } from '../data/siteData';
---

<section class="py-24 bg-gradient-to-br from-[#2D3136] via-[#1f2226] to-[#2D3136] text-white relative overflow-hidden">
  <!-- Decorative brand green glow -->
  <div class="absolute -right-20 -bottom-20 w-[500px] h-[500px] bg-[#469B26]/20 rounded-full blur-3xl pointer-events-none" />
  <div class="absolute -left-20 -top-20 w-[400px] h-[400px] bg-[#469B26]/10 rounded-full blur-3xl pointer-events-none" />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center space-y-8">
    <!-- Badge -->
    <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-[#469B26]/30 text-[#86ef9e] text-xs font-bold uppercase tracking-wider border border-[#469B26]/40">
      <span class="w-2 h-2 rounded-full bg-[#469B26] animate-ping" />
      <span>Get A Free Fuel Price Comparison</span>
    </div>

    <!-- Heading -->
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight max-w-3xl mx-auto">
      Stop Chasing Better Fuel Prices. <br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#86ef9e] via-[#469B26] to-[#5bb834]">
        Start Receiving Them.
      </span>
    </h2>

    <!-- Exact Body Copy -->
    <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-3xl mx-auto">
      We're not interested in winning your business with a short-term offer and then quietly increasing your costs. Whether you run one van, ten taxis or a fleet of HGVs, contact Fleet Fuels today for a free, no-obligation fuel price comparison.
    </p>

    <!-- 3 Core Guarantees -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4 max-w-3xl mx-auto text-left">
      <div class="bg-white/5 border border-white/10 rounded-2xl p-4 flex items-center space-x-3">
        <div class="w-9 h-9 rounded-xl bg-[#469B26] text-white flex items-center justify-center font-black text-sm shrink-0">
          ✓
        </div>
        <div>
          <div class="text-xs font-bold text-white">Transparent Rates</div>
          <div class="text-[11px] text-slate-400">Consistent wholesale pricing</div>
        </div>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-2xl p-4 flex items-center space-x-3">
        <div class="w-9 h-9 rounded-xl bg-[#469B26] text-white flex items-center justify-center font-black text-sm shrink-0">
          ✓
        </div>
        <div>
          <div class="text-xs font-bold text-white">No Creeping Margins</div>
          <div class="text-[11px] text-slate-400">Zero margin inflation</div>
        </div>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-2xl p-4 flex items-center space-x-3">
        <div class="w-9 h-9 rounded-xl bg-[#469B26] text-white flex items-center justify-center font-black text-sm shrink-0">
          ✓
        </div>
        <div>
          <div class="text-xs font-bold text-white">Direct UK Support</div>
          <div class="text-[11px] text-slate-400">Speak to named specialists</div>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="#compare"
        class="btn-primary w-full sm:w-auto px-8 py-4 rounded-xl font-bold text-base text-white shadow-xl flex items-center justify-center space-x-2"
      >
        <span>Compare Your Fuel Rates Now</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <a
        href={`tel:${siteConfig.phone.raw}`}
        class="w-full sm:w-auto px-7 py-4 rounded-xl font-semibold text-sm text-slate-200 hover:text-white bg-white/10 hover:bg-white/15 border border-white/10 transition-all text-center flex items-center justify-center space-x-2"
      >
        <svg class="w-4 h-4 text-[#86ef9e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Call Gary Direct: {siteConfig.phone.display}</span>
      </a>
    </div>

    <p class="text-xs text-slate-400 font-medium">
      Operating Monday - Friday: 08:30 - 17:30 GMT • Fast, paperless account activation
    </p>
  </div>
</section>
