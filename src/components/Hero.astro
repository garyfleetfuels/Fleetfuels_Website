---
import { siteConfig } from '../data/siteData';
---

<section class="relative bg-gradient-to-b from-slate-900 via-[#2D3136] to-slate-900 text-white pt-12 pb-24 overflow-hidden">
  <!-- Subtle background glow effects using primary brand green -->
  <div class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-[#469B26]/15 rounded-full blur-3xl pointer-events-none" />
  <div class="absolute bottom-0 left-10 w-[400px] h-[400px] bg-[#469B26]/10 rounded-full blur-3xl pointer-events-none" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Copy & Value Proposition -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <!-- Badge -->
        <div class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full bg-[#469B26]/20 border border-[#469B26]/40 text-[#86ef9e] text-xs font-bold uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-[#469B26] animate-pulse" />
          <span>UK Commercial Fleet Fuel Management</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight text-white">
          Cut Fleet Fuel Costs by <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#86ef9e] via-[#469B26] to-[#5bb834]">Up to 10p/Litre</span> Across the UK
        </h1>

        <p class="text-lg sm:text-xl text-slate-300 leading-relaxed max-w-2xl mx-auto lg:mx-0">
          Empowering hauliers, van fleets, and British businesses with fixed wholesale diesel rates, consolidated HMRC-approved VAT reporting, and access to over 8,000+ nationwide forecourts.
        </p>

        <!-- Key Metrics Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 max-w-xl mx-auto lg:mx-0">
          <div class="bg-white/5 border border-white/10 rounded-xl p-3 text-center backdrop-blur-sm">
            <div class="text-2xl sm:text-3xl font-black text-[#86ef9e]">8,000+</div>
            <div class="text-[11px] text-slate-300 font-medium uppercase tracking-wider mt-0.5">UK Forecourts</div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-xl p-3 text-center backdrop-blur-sm">
            <div class="text-2xl sm:text-3xl font-black text-[#86ef9e]">10p/L</div>
            <div class="text-[11px] text-slate-300 font-medium uppercase tracking-wider mt-0.5">Max Savings</div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-xl p-3 text-center backdrop-blur-sm">
            <div class="text-2xl sm:text-3xl font-black text-[#86ef9e]">100%</div>
            <div class="text-[11px] text-slate-300 font-medium uppercase tracking-wider mt-0.5">HMRC Compliant</div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-xl p-3 text-center backdrop-blur-sm">
            <div class="text-2xl sm:text-3xl font-black text-[#86ef9e]">0p</div>
            <div class="text-[11px] text-slate-300 font-medium uppercase tracking-wider mt-0.5">Hidden Fees</div>
          </div>
        </div>

        <!-- Trust statement & CTAs -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href="#apply"
            class="btn-primary w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-base text-white text-center shadow-lg hover:shadow-green-500/30 transition-all flex items-center justify-center space-x-2"
          >
            <span>Apply Online in 2 Minutes</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a
            href="#fuel-cards"
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-semibold text-sm text-slate-300 hover:text-white bg-white/10 hover:bg-white/15 border border-white/10 transition-all text-center"
          >
            Explore Fuel Cards
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive Quick Quote Card -->
      <div class="lg:col-span-5" id="apply">
        <div class="bg-white text-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl border border-slate-100 relative">
          <!-- Card Header -->
          <div class="border-b border-slate-100 pb-4 mb-6">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-[#469B26]">Free Fleet Cost Audit</span>
              <span class="text-xs font-semibold bg-[#EBF5E9] text-[#469B26] px-2 py-0.5 rounded">No Obligation</span>
            </div>
            <h3 class="text-xl sm:text-2xl font-black text-[#2D3136] mt-1">
              Request Your Custom Fuel Rates
            </h3>
            <p class="text-xs text-slate-500 mt-1">
              Find out exactly how much your business can save every week.
            </p>
          </div>

          <!-- Application Form -->
          <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you for choosing Fleet Fuels! A senior fuel consultant will contact you within 1 business hour with your wholesale rate quote.');">
            <div>
              <label for="companyName" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Company Name</label>
              <input
                type="text"
                id="companyName"
                name="companyName"
                required
                placeholder="e.g. British Freight Logistics Ltd"
                class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#469B26] focus:border-transparent text-sm placeholder:text-slate-400"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="fleetSize" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Fleet Size</label>
                <select
                  id="fleetSize"
                  name="fleetSize"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#469B26] focus:border-transparent text-sm bg-white"
                >
                  <option value="1-5">1 - 5 Vehicles</option>
                  <option value="6-15" selected>6 - 15 Vehicles</option>
                  <option value="16-50">16 - 50 Vehicles</option>
                  <option value="50+">50+ Heavy Fleet</option>
                </select>
              </div>

              <div>
                <label for="fuelType" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Primary Fuel</label>
                <select
                  id="fuelType"
                  name="fuelType"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#469B26] focus:border-transparent text-sm bg-white"
                >
                  <option value="diesel">Commercial Diesel</option>
                  <option value="petrol">Unleaded Petrol</option>
                  <option value="mixed">Mixed Fleet</option>
                  <option value="hvo">HVO Renewable Diesel</option>
                  <option value="ev">EV / Hybrid</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="contactEmail" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Work Email</label>
                <input
                  type="email"
                  id="contactEmail"
                  name="contactEmail"
                  required
                  placeholder="transport@company.co.uk"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#469B26] focus:border-transparent text-sm placeholder:text-slate-400"
                />
              </div>

              <div>
                <label for="contactPhone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Phone Number</label>
                <input
                  type="tel"
                  id="contactPhone"
                  name="contactPhone"
                  required
                  placeholder="07123 456789"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#469B26] focus:border-transparent text-sm placeholder:text-slate-400"
                />
              </div>
            </div>

            <button
              type="submit"
              class="w-full btn-primary py-3 px-4 rounded-xl font-bold text-sm text-white shadow-md flex items-center justify-center space-x-2 mt-4"
            >
              <span>Get Instant Fleet Pricing</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>

            <p class="text-[11px] text-slate-400 text-center">
              🔒 100% confidential. No spam. Zero card setup obligation.
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
