---
import { siteConfig } from '../data/siteData';
---

<section class="relative bg-gradient-to-b from-slate-900 via-[#2D3136] to-slate-900 text-white pt-12 pb-24 overflow-hidden" id="compare">
  <!-- Subtle ambient decorative glow with brand leaf green -->
  <div class="absolute top-0 right-1/4 w-[600px] h-[600px] bg-[#469B26]/15 rounded-full blur-3xl pointer-events-none" />
  <div class="absolute bottom-0 left-10 w-[450px] h-[450px] bg-[#469B26]/10 rounded-full blur-3xl pointer-events-none" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Exact Copy Narrative -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <!-- Sub-positioning Pill -->
        <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-[#469B26]/20 border border-[#469B26]/40 text-[#86ef9e] text-xs font-bold uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-[#469B26] animate-pulse" />
          <span>Big Fleet Prices. Small Business Service.</span>
        </div>

        <!-- Primary Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-[1.1] text-white">
          Big Fleet Prices. <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#86ef9e] via-[#469B26] to-[#5bb834]">
            Whatever the Size
          </span> of Your Business.
        </h1>

        <!-- Subheadline -->
        <p class="text-xl sm:text-2xl font-bold text-slate-200 tracking-tight">
          Competitive fuel cards. Transparent pricing. <span class="text-[#86ef9e]">No creeping margins.</span>
        </p>

        <!-- Supporting Narrative -->
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto lg:mx-0">
          At Fleet Fuels, we believe every business deserves access to competitive fuel prices, regardless of the size of its fleet. Whether you operate a large haulage company, a fleet of vans, a taxi business or just a single commercial vehicle, we can provide access to competitive fuel rates that have traditionally been reserved for larger fleet operators.
        </p>

        <!-- Trust Badges Row -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2 max-w-lg mx-auto lg:mx-0 text-left">
          <div class="bg-white/5 border border-white/10 rounded-xl p-3 flex items-center space-x-3">
            <svg class="w-5 h-5 text-[#86ef9e] shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <div class="text-xs">
              <div class="font-bold text-white">No Creeping Margins</div>
              <div class="text-slate-400 text-[11px]">Fair rates every week</div>
            </div>
          </div>

          <div class="bg-white/5 border border-white/10 rounded-xl p-3 flex items-center space-x-3">
            <svg class="w-5 h-5 text-[#86ef9e] shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <div class="text-xs">
              <div class="font-bold text-white">From 1 to 100+</div>
              <div class="text-slate-400 text-[11px]">Any vehicle count</div>
            </div>
          </div>

          <div class="bg-white/5 border border-white/10 rounded-xl p-3 flex items-center space-x-3 col-span-2 sm:col-span-1">
            <svg class="w-5 h-5 text-[#86ef9e] shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <div class="text-xs">
              <div class="font-bold text-white">5 Major Networks</div>
              <div class="text-slate-400 text-[11px]">UK-wide forecourts</div>
            </div>
          </div>
        </div>

        <!-- Direct Telephone Link -->
        <div class="pt-2 flex items-center justify-center lg:justify-start space-x-3 text-sm text-slate-300">
          <span>Prefer to talk directly?</span>
          <a href={`tel:${siteConfig.phone.raw}`} class="text-[#86ef9e] font-bold hover:underline flex items-center">
            <span>Call Gary & the team on {siteConfig.phone.display}</span>
          </a>
        </div>
      </div>

      <!-- Right Column: High-Converting 2-Step Quote / Enquiry Form -->
      <div class="lg:col-span-5">
        <div class="bg-white text-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl border border-slate-100 relative">
          <!-- Form Header -->
          <div class="border-b border-slate-100 pb-4 mb-5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-[#469B26]">Fuel Rate Comparison</span>
              <span class="text-xs font-semibold bg-[#EBF5E9] text-[#469B26] px-2.5 py-0.5 rounded-full">100% Free & No Obligation</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-black text-[#2D3136] mt-1.5">
              Compare Your Fuel Rates
            </h2>
            <p class="text-xs text-slate-500 mt-1">
              Find out how much your business can save with big fleet pricing.
            </p>
          </div>

          <!-- Step Progress Indicator -->
          <div class="flex items-center space-x-2 mb-5">
            <div id="step-pill-1" class="flex-1 h-1.5 rounded-full bg-[#469B26] transition-all"></div>
            <div id="step-pill-2" class="flex-1 h-1.5 rounded-full bg-slate-200 transition-all"></div>
          </div>

          <form id="hero-quote-form" onsubmit="event.preventDefault(); window.handleHeroSubmit();">
            <!-- STEP 1: Fleet Details -->
            <div id="form-step-1" class="space-y-4">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                  1. Number of Vehicles in Your Fleet
                </label>
                <div class="grid grid-cols-3 gap-2">
                  <label class="cursor-pointer border border-slate-200 rounded-xl p-2.5 text-center hover:border-[#469B26] has-[:checked]:border-[#469B26] has-[:checked]:bg-[#EBF5E9] transition-all">
                    <input type="radio" name="vehicleCount" value="1" class="sr-only" checked />
                    <span class="block text-sm font-bold text-[#2D3136]">1 Vehicle</span>
                    <span class="block text-[10px] text-slate-500">Sole Trader / Van</span>
                  </label>
                  <label class="cursor-pointer border border-slate-200 rounded-xl p-2.5 text-center hover:border-[#469B26] has-[:checked]:border-[#469B26] has-[:checked]:bg-[#EBF5E9] transition-all">
                    <input type="radio" name="vehicleCount" value="2-5" class="sr-only" />
                    <span class="block text-sm font-bold text-[#2D3136]">2 - 5</span>
                    <span class="block text-[10px] text-slate-500">Small Fleet</span>
                  </label>
                  <label class="cursor-pointer border border-slate-200 rounded-xl p-2.5 text-center hover:border-[#469B26] has-[:checked]:border-[#469B26] has-[:checked]:bg-[#EBF5E9] transition-all">
                    <input type="radio" name="vehicleCount" value="6-20" class="sr-only" />
                    <span class="block text-sm font-bold text-[#2D3136]">6 - 20</span>
                    <span class="block text-[10px] text-slate-500">Medium Fleet</span>
                  </label>
                </div>
                <div class="grid grid-cols-2 gap-2 mt-2">
                  <label class="cursor-pointer border border-slate-200 rounded-xl p-2 text-center hover:border-[#469B26] has-[:checked]:border-[#469B26] has-[:checked]:bg-[#EBF5E9] transition-all">
                    <input type="radio" name="vehicleCount" value="21-50" class="sr-only" />
                    <span class="block text-sm font-bold text-[#2D3136]">21 - 50 Vehicles</span>
                  </label>
                  <label class="cursor-pointer border border-slate-200 rounded-xl p-2 text-center hover:border-[#469B26] has-[:checked]:border-[#469B26] has-[:checked]:bg-[#EBF5E9] transition-all">
                    <input type="radio" name="vehicleCount" value="50+" class="sr-only" />
                    <span class="block text-sm font-bold text-[#2D3136]">50+ Commercial Fleets</span>
                  </label>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for="fuelType" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                    Primary Fuel Type
                  </label>
                  <select
                    id="fuelType"
                    name="fuelType"
                    class="w-full px-3 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#469B26] text-xs font-medium bg-white"
                  >
                    <option value="diesel" selected>Commercial Diesel</option>
                    <option value="petrol">Unleaded Petrol</option>
                    <option value="mixed">Mixed (Diesel & Petrol)</option>
                    <option value="hgv-diesel">Heavy HGV Diesel</option>
                  </select>
                </div>

                <div>
                  <label for="weeklySpend" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                    Approx. Weekly Spend
                  </label>
                  <select
                    id="weeklySpend"
                    name="weeklySpend"
                    class="w-full px-3 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#469B26] text-xs font-medium bg-white"
                  >
                    <option value="under-500">Under £500 / week</option>
                    <option value="500-2000" selected>£500 - £2,000 / week</option>
                    <option value="2000-5000">£2,000 - £5,000 / week</option>
                    <option value="5000-plus">£5,000+ / week</option>
                  </select>
                </div>
              </div>

              <button
                type="button"
                id="btn-next-step"
                class="w-full btn-primary py-3.5 px-4 rounded-xl font-bold text-sm text-white shadow-md flex items-center justify-center space-x-2 mt-2"
              >
                <span>Continue to Step 2</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>
            </div>

            <!-- STEP 2: Contact Information (Hidden initially) -->
            <div id="form-step-2" class="space-y-3.5 hidden">
              <div>
                <label for="businessName" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                  Business / Trading Name *
                </label>
                <input
                  type="text"
                  id="businessName"
                  name="businessName"
                  required
                  placeholder="e.g. Apex Haulage Ltd / John Smith Plumbing"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#469B26] text-xs sm:text-sm"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for="contactName" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                    Contact Name *
                  </label>
                  <input
                    type="text"
                    id="contactName"
                    name="contactName"
                    required
                    placeholder="Your Full Name"
                    class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#469B26] text-xs sm:text-sm"
                  />
                </div>

                <div>
                  <label for="contactPhone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                    Telephone / Mobile *
                  </label>
                  <input
                    type="tel"
                    id="contactPhone"
                    name="contactPhone"
                    required
                    placeholder="07123 456789"
                    class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#469B26] text-xs sm:text-sm"
                  />
                </div>
              </div>

              <div>
                <label for="contactEmail" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                  Business Email Address *
                </label>
                <input
                  type="email"
                  id="contactEmail"
                  name="contactEmail"
                  required
                  placeholder="name@business.co.uk"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#469B26] text-xs sm:text-sm"
                />
              </div>

              <div class="flex items-center space-x-2 pt-2">
                <button
                  type="button"
                  id="btn-back-step"
                  class="py-3 px-3 rounded-xl border border-slate-300 text-slate-600 font-semibold text-xs hover:bg-slate-50 transition-colors"
                >
                  ← Back
                </button>
                <button
                  type="submit"
                  class="flex-1 btn-primary py-3 px-4 rounded-xl font-bold text-xs sm:text-sm text-white shadow-md flex items-center justify-center space-x-2"
                >
                  <span>Get My Fuel Price Comparison</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </button>
              </div>

              <p class="text-[11px] text-slate-400 text-center pt-1">
                🔒 No credit card required. No pushy sales calls. Zero creeping margins guaranteed.
              </p>
            </div>
          </form>

          <!-- Success Message State (Hidden initially) -->
          <div id="form-success" class="hidden py-8 text-center space-y-4">
            <div class="w-16 h-16 rounded-full bg-[#EBF5E9] text-[#469B26] flex items-center justify-center mx-auto shadow-inner">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h3 class="text-xl font-black text-[#2D3136]">Thank You for Contacting Fleet Fuels!</h3>
            <p class="text-xs text-slate-600 leading-relaxed max-w-sm mx-auto">
              We have received your fleet information. A dedicated UK fuel specialist will compare wholesale card rates for your vehicle count and contact you within 1 business hour.
            </p>
            <div class="pt-2 text-xs font-bold text-[#469B26]">
              Big Fleet Prices. Small Business Service.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const step1 = document.getElementById('form-step-1');
  const step2 = document.getElementById('form-step-2');
  const stepPill1 = document.getElementById('step-pill-1');
  const stepPill2 = document.getElementById('step-pill-2');
  const btnNext = document.getElementById('btn-next-step');
  const btnBack = document.getElementById('btn-back-step');
  const form = document.getElementById('hero-quote-form');
  const formSuccess = document.getElementById('form-success');

  if (btnNext && step1 && step2 && stepPill2) {
    btnNext.addEventListener('click', () => {
      step1.classList.add('hidden');
      step2.classList.remove('hidden');
      stepPill2.classList.remove('bg-slate-200');
      stepPill2.classList.add('bg-[#469B26]');
    });
  }

  if (btnBack && step1 && step2 && stepPill2) {
    btnBack.addEventListener('click', () => {
      step2.classList.add('hidden');
      step1.classList.remove('hidden');
      stepPill2.classList.remove('bg-[#469B26]');
      stepPill2.classList.add('bg-slate-200');
    });
  }

  declare global {
    interface Window {
      handleHeroSubmit: () => void;
    }
  }

  window.handleHeroSubmit = () => {
    if (form && formSuccess) {
      form.classList.add('hidden');
      formSuccess.classList.remove('hidden');
    }
  };
</script>
