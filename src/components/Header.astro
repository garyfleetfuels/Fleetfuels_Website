---
import { siteConfig } from '../data/siteData';
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs transition-all duration-200">
  <!-- Top Utility Bar -->
  <div class="bg-[#2D3136] text-white text-xs py-2 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
      <div class="flex items-center space-x-2 text-slate-300">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-[#469B26] text-white">
          UK FLEET SAVINGS
        </span>
        <span class="hidden md:inline">Wholesale weekly pricing & zero transaction fees on commercial diesel</span>
        <span class="md:hidden">Fixed wholesale weekly diesel pricing</span>
      </div>
      <div class="flex items-center space-x-4 text-xs font-medium">
        <a href={`tel:${siteConfig.phone.raw}`} class="flex items-center hover:text-[#469B26] transition-colors">
          <svg class="w-3.5 h-3.5 mr-1.5 text-[#469B26]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="text-white font-semibold">{siteConfig.phone.display}</span>
        </a>
        <span class="text-slate-500 hidden sm:inline">|</span>
        <span class="text-slate-400 hidden sm:inline">{siteConfig.officeHours}</span>
      </div>
    </div>
  </div>

  <!-- Primary Navigation -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <!-- Logo Branding -->
      <a href="/" class="flex items-center space-x-3 group" aria-label="Fleet Fuels Homepage">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-[#469B26] to-[#2c6319] flex items-center justify-center p-2 shadow-md shadow-[#469B26]/20 group-hover:scale-105 transition-transform">
          <svg viewBox="0 0 24 24" class="w-7 h-7 text-white fill-current" xmlns="http://www.w3.org/2000/svg">
            <!-- Sleek droplet stylized icon matching Fleet Fuels identity -->
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
          </svg>
        </div>
        <div class="flex flex-col">
          <div class="flex items-baseline space-x-1">
            <span class="text-2xl font-black tracking-tight text-[#2D3136]">FLEET</span>
            <span class="text-2xl font-black tracking-tight text-[#469B26]">FUELS</span>
          </div>
          <span class="text-[10px] uppercase font-bold tracking-widest text-slate-500 -mt-1">Commercial Fuel Cards</span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden lg:flex items-center space-x-8 text-sm font-semibold text-[#2D3136]">
        {siteConfig.nav.map((item) => (
          <a
            href={item.href}
            class="hover:text-[#469B26] transition-colors py-2 relative group"
          >
            {item.name}
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#469B26] transition-all duration-200 group-hover:w-full" />
          </a>
        ))}
      </nav>

      <!-- Action Buttons -->
      <div class="hidden md:flex items-center space-x-4">
        <a
          href="#apply"
          class="btn-primary inline-flex items-center justify-center px-5 py-2.5 rounded-lg text-sm font-bold text-white shadow-md hover:shadow-lg transition-all"
        >
          <span>Apply for Fuel Cards</span>
          <svg class="w-4 h-4 ml-2 -mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center lg:hidden">
        <button
          type="button"
          id="mobile-menu-btn"
          class="inline-flex items-center justify-center p-2 rounded-lg text-slate-700 hover:text-[#469B26] hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-[#469B26]"
          aria-expanded="false"
          aria-label="Toggle Navigation Menu"
        >
          <svg id="menu-icon-open" class="block h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="hidden h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 space-y-3 shadow-lg">
    <div class="space-y-1">
      {siteConfig.nav.map((item) => (
        <a
          href={item.href}
          class="block px-3 py-2.5 rounded-md text-base font-medium text-slate-800 hover:bg-[#EBF5E9] hover:text-[#469B26] transition-colors"
        >
          {item.name}
        </a>
      ))}
    </div>
    <div class="pt-3 border-t border-slate-200 space-y-2">
      <a
        href="#apply"
        class="w-full btn-primary flex items-center justify-center px-4 py-3 rounded-lg text-base font-bold text-white shadow-md"
      >
        Apply for Fuel Cards
      </a>
      <a
        href={`tel:${siteConfig.phone.raw}`}
        class="w-full flex items-center justify-center px-4 py-3 rounded-lg text-sm font-semibold text-slate-800 bg-slate-100 hover:bg-slate-200"
      >
        Call {siteConfig.phone.display}
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    // Close menu when clicking a link
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      });
    });
  }
</script>
