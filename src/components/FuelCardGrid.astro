---
import { fuelCards } from '../data/fuelCards';
---

<section id="fuel-cards" class="py-20 bg-slate-900 text-white relative overflow-hidden">
  <!-- Ambient subtle glow -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-[#469B26]/10 rounded-full blur-3xl pointer-events-none" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1 rounded-full bg-[#469B26]/20 border border-[#469B26]/40 text-[#86ef9e] text-xs font-bold uppercase tracking-wider mb-4">
        <span>Tailored Card Solutions</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight">
        A Choice of Fuel Cards to <span class="text-[#86ef9e]">Suit Your Business</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
        Match cards to your regional, local, or nationwide routes and preferred forecourts. Transparent wholesale rates, no creeping margins, and zero weekly card fees.
      </p>

      <!-- Category Filter Tabs -->
      <div class="mt-8 flex flex-wrap justify-center gap-2 p-1.5 bg-white/5 rounded-2xl border border-white/10 max-w-lg mx-auto backdrop-blur-sm">
        <button
          type="button"
          data-filter="all"
          class="card-filter active px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all bg-[#469B26] text-white shadow-xs"
        >
          All 5 Networks
        </button>
        <button
          type="button"
          data-filter="Vans"
          class="card-filter px-4 py-2 rounded-xl text-xs sm:text-sm font-medium text-slate-300 hover:text-white transition-all"
        >
          Vans & Couriers
        </button>
        <button
          type="button"
          data-filter="HGVs"
          class="card-filter px-4 py-2 rounded-xl text-xs sm:text-sm font-medium text-slate-300 hover:text-white transition-all"
        >
          HGVs & Haulage
        </button>
        <button
          type="button"
          data-filter="Taxis"
          class="card-filter px-4 py-2 rounded-xl text-xs sm:text-sm font-medium text-slate-300 hover:text-white transition-all"
        >
          Taxis & Cars
        </button>
      </div>
    </div>

    <!-- 5 Fuel Cards Grid -->
    <div id="cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {fuelCards.map((card) => (
        <div
          class="fuel-card-wrapper bg-white/5 border border-white/10 rounded-3xl p-6 sm:p-7 hover:border-[#469B26]/60 hover:bg-white/10 transition-all duration-300 flex flex-col justify-between group backdrop-blur-sm shadow-xl"
          data-vehicles={card.vehicleTypes.join(',')}
        >
          <div class="space-y-6">
            <!-- Realistic Visual Card Mockup -->
            <div class={`w-full aspect-[1.58/1] rounded-2xl p-5 bg-gradient-to-br ${card.cardDesign.gradient} text-white shadow-2xl relative overflow-hidden border border-white/20 flex flex-col justify-between group-hover:scale-[1.02] transition-transform duration-300`}>
              <!-- Card Sheen Reflection -->
              <div class="absolute inset-0 bg-gradient-to-tr from-white/0 via-white/10 to-transparent pointer-events-none" />

              <!-- Card Top Row: Network & Chip -->
              <div class="flex items-center justify-between relative z-10">
                <!-- Gold EMV Chip Graphic -->
                <div class="w-10 h-7 rounded-md bg-gradient-to-br from-amber-200 via-yellow-400 to-amber-500 border border-amber-600/50 shadow-inner relative overflow-hidden flex items-center justify-center">
                  <div class="w-full h-[1px] bg-amber-700/40 absolute top-2.5"></div>
                  <div class="w-full h-[1px] bg-amber-700/40 absolute bottom-2.5"></div>
                  <div class="h-full w-[1px] bg-amber-700/40 absolute left-3"></div>
                  <div class="h-full w-[1px] bg-amber-700/40 absolute right-3"></div>
                </div>

                <!-- Brand / Network Identifier Badge -->
                <span class={`px-2.5 py-1 rounded-md text-[11px] font-black tracking-wider uppercase ${card.cardDesign.accentBadge} shadow-sm`}>
                  {card.cardDesign.brandLabel}
                </span>
              </div>

              <!-- Card Middle: Contactless Icon & Fleet Fuels Logo -->
              <div class="flex items-center justify-between relative z-10 my-1">
                <div class="flex items-center space-x-1.5 opacity-90">
                  <div class="w-5 h-5 rounded-full bg-[#469B26] flex items-center justify-center p-1">
                    <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-white fill-current" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
                    </svg>
                  </div>
                  <span class="text-xs font-black tracking-tight text-white">FLEET FUELS</span>
                </div>
                <!-- Contactless wave icon -->
                <svg class="w-5 h-5 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.393 9.393c5.857-5.857 15.355-5.857 21.213 0" />
                </svg>
              </div>

              <!-- Card Bottom: Card Number & Details -->
              <div class="relative z-10 pt-1">
                <div class="font-mono text-xs sm:text-sm tracking-widest text-white/90 drop-shadow-sm font-semibold">
                  •••• •••• •••• 4026
                </div>
                <div class="flex items-center justify-between text-[10px] uppercase tracking-wider text-white/80 font-semibold mt-1">
                  <span>COMMERCIAL FLEET</span>
                  <span>REG SPECIFIC</span>
                </div>
              </div>
            </div>

            <!-- Card Information Details -->
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-0.5 rounded text-[11px] font-bold bg-[#469B26]/20 text-[#86ef9e] border border-[#469B26]/30">
                  {card.badge}
                </span>
                <span class="text-xs font-semibold text-slate-400">
                  {card.coverage}
                </span>
              </div>

              <h3 class="text-2xl font-black text-white group-hover:text-[#86ef9e] transition-colors">
                {card.name}
              </h3>

              <p class="text-xs text-slate-300 leading-relaxed">
                {card.summary}
              </p>

              <!-- Feature Bullets (No static prices) -->
              <div class="pt-2">
                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">Network Highlights</div>
                <ul class="space-y-2 text-xs text-slate-300">
                  {card.features.map((feat) => (
                    <li class="flex items-start">
                      <svg class="w-4 h-4 mr-2 text-[#86ef9e] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      <span class="leading-snug">{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <!-- Bottom Actions -->
          <div class="pt-6 mt-6 border-t border-white/10 space-y-2">
            <a
              href="#compare"
              class="w-full btn-primary py-3 px-4 rounded-xl text-center text-xs sm:text-sm font-bold text-white shadow-md block"
            >
              Get Rates for {card.name}
            </a>
            <div class="text-center text-[11px] text-slate-400 font-medium">
              Zero weekly card fees • Transparent wholesale margins
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Footnote Guidance -->
    <div class="mt-14 p-5 rounded-2xl bg-white/5 border border-white/10 max-w-3xl mx-auto text-center backdrop-blur-sm">
      <p class="text-xs sm:text-sm text-slate-300">
        💡 <strong>Multi-network accounts available:</strong> Many fleets carry a combination of cards (e.g. UK Fuels for regional vans + Shell for motorway transport) on a single unified invoice. Call <a href="tel:07525863838" class="text-[#86ef9e] font-bold underline">07525 863838</a> or email <a href="mailto:sales@fleetfuels.co.uk" class="text-[#86ef9e] font-bold underline">sales@fleetfuels.co.uk</a> to discuss your specific driver routes.
      </p>
    </div>
  </div>
</section>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.card-filter');
  const cardElements = document.querySelectorAll<HTMLElement>('.fuel-card-wrapper');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => {
        b.classList.remove('active', 'bg-[#469B26]', 'text-white', 'shadow-xs');
        b.classList.add('text-slate-300');
      });
      btn.classList.add('active', 'bg-[#469B26]', 'text-white', 'shadow-xs');
      btn.classList.remove('text-slate-300');

      const filter = btn.getAttribute('data-filter') || 'all';

      cardElements.forEach((card) => {
        const vehicles = card.getAttribute('data-vehicles') || '';
        if (filter === 'all' || vehicles.includes(filter)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
