    vehicles: '2 to 15 Vehicles',
    description: 'Stop paying inflated pump markups or getting ignored by mega-brokers. Access identical commercial wholesale diesel rates to national carriers.',
    badge: 'Independent Hauliers',
    icon: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4',
  },
  {
