---

<section id="target-fleets" class="py-20 bg-slate-50 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-flex items-center px-3.5 py-1 rounded-full bg-[#EBF5E9] text-[#469B26] text-xs font-bold uppercase tracking-wider mb-4 border border-[#bbf7cb]">
        Tailored Solutions
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#2D3136] tracking-tight">
        Large Fleet Fuel Prices for <br class="hidden sm:inline" />
        <span class="text-[#469B26]">Businesses of Every Size</span>
      </h2>
      <p class="mt-4 text-lg sm:text-xl font-bold text-slate-700 italic">
        "You don't need 50 lorries to benefit from big fleet fuel prices."
      </p>
      <p class="mt-2 text-sm sm:text-base text-slate-600 max-w-2xl mx-auto">
        From independent contractors running a single van to national haulage fleets, Fleet Fuels levels the playing field with commercial wholesale rates and dedicated UK support.
      </p>
    </div>

    <!-- 7 Segments Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {segments.map((seg, idx) => (
        <div class={`bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between hover:border-[#469B26]/60 group ${idx === 6 ? 'md:col-span-2 lg:col-span-1' : ''}`}>
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-[#EBF5E9] text-[#469B26]">
                {seg.badge}
              </span>
              <div class="w-10 h-10 rounded-xl bg-slate-100 group-hover:bg-[#469B26] text-slate-700 group-hover:text-white flex items-center justify-center transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={seg.icon} />
                </svg>
              </div>
            </div>

            <h3 class="text-xl font-black text-[#2D3136] mb-1 group-hover:text-[#469B26] transition-colors">
              {seg.title}
            </h3>
            <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">
              {seg.vehicles}
            </p>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              {seg.description}
            </p>
          </div>

          <div class="pt-4 mt-5 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500">Commercial Wholesale Rates</span>
            <a href="#compare" class="text-xs font-bold text-[#469B26] hover:underline flex items-center">
              <span>Get Rates</span>
              <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
