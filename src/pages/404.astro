---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/siteData';
---

<BaseLayout
  title={`Page Not Found (404) | ${siteConfig.name}`}
  description="The requested page could not be found on Fleet Fuels UK."
>
  <div class="min-h-[70vh] flex items-center justify-center py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full text-center space-y-6">
      <div class="w-20 h-20 rounded-2xl bg-[#EBF5E9] text-[#469B26] flex items-center justify-center mx-auto shadow-md">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>

      <div class="space-y-2">
        <p class="text-xs font-bold uppercase tracking-wider text-[#469B26]">Error 404</p>
        <h1 class="text-3xl sm:text-4xl font-black text-[#2D3136]">Page Not Found</h1>
        <p class="text-slate-600 text-sm">
          The page or fuel resource you are looking for has been moved or does not exist.
        </p>
      </div>

      <div class="pt-4 flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/"
          class="btn-primary px-6 py-2.5 rounded-xl font-bold text-sm text-white shadow-md"
        >
          Return to Homepage
        </a>
        <a
          href="/#fuel-cards"
          class="px-6 py-2.5 rounded-xl font-semibold text-sm text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 transition-colors"
        >
          Browse Fuel Cards
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
