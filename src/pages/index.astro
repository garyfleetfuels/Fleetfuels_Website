---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FuelCardGrid from '../components/FuelCardGrid.astro';
import BenefitsSection from '../components/BenefitsSection.astro';
import NetworkCoverage from '../components/NetworkCoverage.astro';
import BulkFuelSection from '../components/BulkFuelSection.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { siteConfig } from '../data/siteData';
---

<BaseLayout
  title={`${siteConfig.name} | Commercial Fleet Fuel Cards & Nationwide Management`}
  description="Reduce commercial fleet refuelling costs with Fleet Fuels. Fixed wholesale diesel pricing, HMRC-compliant VAT reporting, and nationwide forecourt access across 8,000+ UK stations."
>
  <Hero />
  <FuelCardGrid />
  <BenefitsSection />
  <NetworkCoverage />
  <BulkFuelSection />
  <CtaBanner />
</BaseLayout>
